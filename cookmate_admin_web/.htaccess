# Food CHART Web Admin - Production Apache Configuration
# ----------------------------------------------------

# 1. Explicitly Set Default Index File (Prevents 403 on root domain)
DirectoryIndex index.php index.html

# 2. Prevent Directory Browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# 3. Set Default Charset
AddDefaultCharset UTF-8

# 4. Deny direct web access to sensitive files
<FilesMatch "(?i)^(\.env|\.git.*|composer\.(json|lock)|package\.json|.*\.sql|.*\.md)$">
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# 5. Security Headers (if mod_headers is enabled)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
